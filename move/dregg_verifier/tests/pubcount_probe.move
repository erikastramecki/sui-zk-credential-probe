#[test_only]
/// Sui's native Groth16 verifier caps public inputs at 8. That cap is in the
/// framework, not in any circuit choice:
///
///   sui-framework/sources/crypto/groth16.move
///     const ETooManyPublicInputs: u64 = 2;
///     const MaxPublicInputs: u64 = 8;
///
/// These two tests are the executable form. Fixtures came from `manypub.rs` in
/// erikastramecki/dregg-sui (squares circuit, N public inputs).
module dregg_verifier::pubcount_probe {
    use dregg_verifier::verifier;

    fun vk8(): vector<u8> { x"" }
    fun pf8(): vector<u8> { x"93535a9e1de02dd2075e5c3f1dc5cba12295b5b51f4a95fe31f1a835545c0992c37c2c0580c5f28537f837522d8e295f21c4c200ebd4dc92f0d8e22ba00f9d24f58cfcc6594ea6d6ea6d303ad82bfcba4abba57f4d9e2b76e3a54f3ae055681785e33450ba85396f0157a2eb229c4cbf38195ab1922b56e354bd1071522bb49a" }
    fun pi8(): vector<u8> { x"" }
    fun vk9(): vector<u8> { x"" }
    fun pf9(): vector<u8> { x"78fb02add4e8ff33c19d604138a49ddada7c7edf328d20a9dd8e9b8240d4a70ab35b5fa914212c908c43b7f5b708fa35e4fc0c257309d79fd7b7ae7faac96505cec5ddde2c19f964197f628ae8f9561377417ea078d5ef1487cb7f051636bd1c85b452daf27d5452220defb5ab2c86b6d79ba1a824f3128929e7fa4f74537290" }
    fun pi9(): vector<u8> { x"" }

    /// 8 public inputs: at the cap, verifies.
    #[test]
    fun eight_publics_verify() { assert!(verifier::verify(vk8(), pi8(), pf8()), 8); }

    /// 9 public inputs: aborts in sui::groth16::prepare_verifying_key with
    /// ETooManyPublicInputs (code 2) -- before the proof is ever examined.
    #[test]
    #[expected_failure]
    fun nine_publics_abort() { verifier::verify(vk9(), pi9(), pf9()); }
}
